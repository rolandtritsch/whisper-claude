WW_AUDIO_CHUNK_SIZE=1024
WW_AUDIO_SAMPLE_RATE=16000
WW_HOTKEY=ctrl+compose
WW_LOG_LEVEL=INFO
WW_MAX_RECORDING_DURATION=30
WW_MIC_CHECK_DURATION=1.0
